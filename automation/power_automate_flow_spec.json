{
  "name": "Automated Freight Invoice Reconciliation",
  "version": "1.0",
  "purpose": "Ingest carrier invoices, run deterministic reconciliation, and route material exceptions for human review.",
  "trigger": {
    "type": "outlook_new_email_with_attachment",
    "mailbox": "shared-freight-invoices@contoso.example",
    "accepted_extensions": [".pdf", ".csv"],
    "save_directory": "inbox_drop/",
    "local_demo_watch": "inbox_drop/*.csv",
    "canonical_invoice_path": "data/carrier_invoices_raw.csv"
  },
  "actions": [
    {"name": "extract_invoice_attachment", "connector": "Office365 Outlook"},
    {"name": "normalize_invoice_data", "implementation": "Python ETL or Power Query"},
    {"name": "run_three_way_reconciliation", "implementation": "src/reconciliation_engine.py"},
    {"name": "write_audit_log", "target": "data/reconciled_audit_log.csv"}
  ],
  "exception_route": {
    "condition": "status == 'DISCREPANCY_FLAGGED' or status == 'REVIEW_INCOMPLETE' or status == 'DUPLICATE_BILLING_BLOCKED' or variance_pct > 0.05",
    "queue_path": "automation/discrepancy_queue.json",
    "queue_format": "JSON array of exception objects",
    "local_desktop_trigger": "Wait for file creation",
    "cloud_trigger": "OneDrive or SharePoint file created",
    "notification": "Microsoft Teams Adaptive Card",
    "template": "automation/teams_card_template.json",
    "recipient": "Logistics Manager"
  },
  "approval_branches": {
    "approve_overcharge": {"actions": ["record_manager_approval", "release_invoice_to_ap"], "audit_required": true, "blocked_when": "status == 'DUPLICATE_BILLING_BLOCKED'"},
    "send_ai_dispute": {"actions": ["request_dispute_draft", "send_for_procurement_review", "record_credit_memo_request"], "audit_required": true}
  },
  "outbound_dispute_dispatch": {
    "source_table": "dispute_dispatches",
    "trigger": "Power Automate Desktop scheduled polling",
    "poll_interval_seconds": 60,
    "poll_filter": "email_dispatch_status eq PENDING",
    "poll_endpoint": "/rest/v1/dispute_dispatches?email_dispatch_status=eq.PENDING&order=queued_at.asc",
    "email_columns": {
      "to": "dispute_to_email",
      "cc": "dispute_cc_email",
      "from": "dispute_from_email",
      "subject": "dispute_subject",
      "body": "dispute_memo_body",
      "attachment_content_base64": "dispute_evidence_pdf_base64",
      "attachment_filename": "dispute_evidence_filename"
    },
    "sender": "nadiaravindra07@outlook.com (configured directly in the Outlook action)",
    "record_key": "dispatch_id",
    "outlook_action": "Send an email (V2)",
    "dispatch_record_lookup": "Poll pending dispatches and process each row by dispatch_id.",
    "attachment_action": "When dispute_evidence_pdf_base64 is not empty, attach base64ToBinary(dispute_evidence_pdf_base64) using dispute_evidence_filename.",
    "success_update": {
      "email_dispatch_status": "SENT",
      "dispatched_at": "UTC timestamp",
      "error_message": null
    },
    "failure_update": {
      "email_dispatch_status": "FAILED",
      "error_message": "Power Automate Outlook send failure details"
    },
    "confirmed_dispute_lifecycle": {
      "trigger": "Database trigger after email_dispatch_status changes to SENT",
      "invoice_status": "DISPUTED",
      "dispute_date": "dispatched_at",
      "rebuttal_deadline": "dispatched_at + 30 days",
      "resolution_states": ["DISPUTED", "REBUTTAL_RECEIVED", "CLOSED_RESOLVED", "CLOSED_OVERRIDDEN"]
    },
    "streamlit_queue_behavior": "Insert PENDING dispatch and atomically set invoice audit_status to DISPUTED; close composer and rerun without making an HTTP request."
  }
}
